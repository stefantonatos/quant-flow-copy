//@version=6
// ============================================================================
// ==== ASIA SWEEP + CHANGE IN STATE OF DELIVERY ==============================
// ============================================================================
//
// From a video transcript. The rules as stated:
//
//   1. Mark the Asian session high and low (he uses Leviathan's Market
//      Sessions indicator; a screenshot confirms it is set to UTC).
//   2. Wait for price to sweep one side of that range.
//   3. Drop to the 5-minute chart and wait for a change in the state of
//      delivery (CSD).
//   4. Enter on the close of the CSD candle.
//   5. Target the OPPOSITE Asia level. He calls it a "3RR trade".
//
// This is the TradingView twin of AsiaSweepCSD in strategies.py -- same
// inputs, same defaults, so the two can be compared.
//
// ---------------------------------------------------------------------------
// READ THIS BEFORE BELIEVING THE "3RR"
// ---------------------------------------------------------------------------
// The target is a fixed PRICE, not an R multiple. The stop is below the sweep.
// So the reward-to-risk of any given setup is whatever the distance between
// those two happens to be on the day -- sometimes 3R, often much less. "3RR"
// describes the example that was on his screen; it is not a rule the strategy
// enforces, and nothing here can make it one.
//
// `minRR` lets you require a minimum. It defaults to 0 (take everything) so
// that trades are not being silently filtered out by a rule he never stated.
// Turning it up will raise the average R and cut the number of trades; whether
// that is an improvement is a question for the Strategy Tester, not for me.
//
// ---------------------------------------------------------------------------
// WHAT HE DID NOT DEFINE, AND WHAT I CHOSE
// ---------------------------------------------------------------------------
// "Change in state of delivery" was never defined, and when asked, Stefan said
// he didn't know either. So it is an input:
//
//   "candle" (default) -- the standard ICT reading: the first bar that CLOSES
//                         back above the high of the most recent down-close
//                         bar (mirrored for shorts). Tight and unambiguous.
//   "swing"            -- looser: a close beyond the extreme of the last N
//                         bars, i.e. a small break of structure.
//
// Put it on a chart, look at where the triangles land, and pick whichever one
// matches what you actually mark by hand. That is a faster way to settle this
// than any amount of describing it in words.
//
// SESSION TIMES ARE CONFIRMED, not guessed. A screenshot of Stefan's Leviathan
// Market Sessions panel shows Tokyo 00:00-09:00, London 07:00-16:00, New York
// 13:00-22:00, Sydney 21:00-06:00 (unticked). His "Asia" is the Tokyo block, so
// the default here is 00:00-09:00 UTC. An earlier default of 00:00-08:00 was
// wrong by an hour and produced a narrower range than his chart shows.
//
// If you run this against a different sessions setup, match that one instead --
// every level in this script hangs off this single range.
//
// SET COMMISSION AND SLIPPAGE before reading any result.
// ============================================================================

strategy("Asia Sweep CSD", shorttitle="AsiaCSD", overlay=true,
         max_lines_count=500, max_boxes_count=500, max_labels_count=500,
         default_qty_type=strategy.percent_of_equity, default_qty_value=100,
         commission_type=strategy.commission.percent, commission_value=0.0,
         slippage=1, initial_capital=10000, pyramiding=0,
         calc_on_every_tick=false, process_orders_on_close=true)
// process_orders_on_close=true is deliberate. The rule is "enter on the CLOSE
// of the CSD candle". Left false, a market order submitted as that bar closes
// fills at the NEXT bar's open instead -- a whole bar late, on a setup whose
// entire premise is momentum shifting at that exact candle. It also keeps this
// aligned with the Python twin, which enters at bars[i].c.

// ==================
// ==== Inputs ======
// ==================

grpSess  = "Session"
grpEntry = "Entry"
grpTrade = "Trade Geometry"
grpDisp  = "Display"

asiaSess = input.session("0000-0900", "Asia Session", group=grpSess,
     tooltip="CONFIRMED against Stefan's Leviathan Market Sessions settings: his Asia is the Tokyo block, 00:00-09:00 UTC. Every level in this script derives from this range, so if it is wrong, everything downstream is wrong.")
sessTZ   = input.string("UTC", "Session Timezone", group=grpSess,
     tooltip="The Leviathan indicator screenshot shows UTC. Change only if yours is set differently.")
tradeSess = input.session("0900-2100", "Trading Window", group=grpSess,
     tooltip="When setups may trigger. Starts when Asia closes at 09:00.")

csdMode = input.string("candle", "Change in State of Delivery", options=["candle", "swing"], group=grpEntry,
     tooltip="candle = first close back above the high of the most recent down-close bar (standard ICT reading). swing = a close beyond the extreme of the last N bars, a small break of structure.")
swingLookback = input.int(5, "Swing Lookback (swing mode)", minval=1, group=grpEntry)
onePerDay = input.bool(true, "One trade per day", group=grpEntry)

stopBufferATR = input.float(0.10, "Stop Buffer beyond the sweep (x ATR)", minval=0, step=0.05, group=grpTrade,
     tooltip="The stop goes below the wick that swept the level. This is padding beyond it.")
minRR  = input.float(0.0, "Minimum Reward:Risk (0 = take everything)", minval=0, step=0.5, group=grpTrade,
     tooltip="The target is a fixed level, so R:R varies by setup. 0 takes every valid setup, which is what the transcript actually describes.")
atrLen = input.int(14, "ATR Length", minval=1, group=grpTrade)

showRange   = input.bool(true, "Asia session box + levels", group=grpDisp)
showBracket = input.bool(true, "TP / SL boxes", group=grpDisp)
showCSD     = input.bool(true, "CSD line", group=grpDisp)
csdExtendBack = input.int(6, "CSD line: bars drawn back", minval=0, maxval=60, group=grpDisp,
     tooltip="How far left of the entry to draw the CSD level, so you can see the candle it came from.")
boxTransp   = input.int(82, "TP/SL box transparency", minval=0, maxval=100, group=grpDisp)
tpColor     = input.color(#089981, "Take Profit", group=grpDisp)
slColor     = input.color(#F23645, "Stop Loss", group=grpDisp)
csdColor    = input.color(#FF9800, "CSD line", group=grpDisp)
asiaColor   = input.color(#2962FF, "Asia session", group=grpDisp)
bullColor   = input.color(#089981, "Bullish marker", group=grpDisp)
bearColor   = input.color(#F23645, "Bearish marker", group=grpDisp)

// ==========================================
// ==== Indicators -- global scope only =====
// ==========================================

atrVal = ta.atr(atrLen)

inAsia  = not na(time(timeframe.period, asiaSess, sessTZ))
inTrade = not na(time(timeframe.period, tradeSess, sessTZ))

// ta.highest/ta.lowest must run every bar or their state corrupts -- a trap
// already hit once in this repo (see CLAUDE.md).
swingHi = ta.highest(high, swingLookback)
swingLo = ta.lowest(low, swingLookback)

// ==========================================
// ==== Step 1: build the Asia range ========
// ==========================================

var float asiaHigh = na
var float asiaLow  = na
var float liveHigh = na
var float liveLow  = na

asiaStarted = inAsia and not inAsia[1]

if asiaStarted
    liveHigh := high
    liveLow  := low
else if inAsia
    liveHigh := math.max(nz(liveHigh, high), high)
    liveLow  := math.min(nz(liveLow, low), low)

// The range is only usable once the session has CLOSED. Publishing it while
// Asia is still printing would let the strategy trade a level that is still
// moving -- which is lookahead dressed up as a session filter.
if not inAsia and inAsia[1]
    asiaHigh := liveHigh
    asiaLow  := liveLow

// ==========================================
// ==== Per-day state =======================
// ==========================================

var bool  sweptLow    = false
var bool  sweptHigh   = false
var float sweepLowPx  = na
var float sweepHighPx = na
var float lastDownHigh = na
var float lastUpLow    = na
var bool  tookLong    = false
var bool  tookShort   = false

// Reset everything when a new Asia session begins.
if asiaStarted
    sweptLow    := false
    sweptHigh   := false
    sweepLowPx  := na
    sweepHighPx := na
    tookLong    := false
    tookShort   := false

// ==========================================
// ==== Step 2: the sweep ===================
// ==========================================

canTrade = inTrade and not inAsia and not na(asiaHigh) and not na(asiaLow) and
     not na(atrVal) and atrVal > 0

if canTrade
    if low < asiaLow
        sweptLow   := true
        sweepLowPx := na(sweepLowPx) ? low : math.min(sweepLowPx, low)
    if high > asiaHigh
        sweptHigh   := true
        sweepHighPx := na(sweepHighPx) ? high : math.max(sweepHighPx, high)

// ==========================================
// ==== Steps 3-5: CSD, entry, target =======
// ==========================================
// The reference levels are the ones as they stood BEFORE this bar, so a bar
// can never satisfy its own condition. The trackers are updated at the very
// bottom of the script for exactly that reason.

refHigh = csdMode == "swing" ? swingHi[1] : lastDownHigh
refLow  = csdMode == "swing" ? swingLo[1] : lastUpLow

var float restStop   = na
var float restTarget = na
var float restEntry  = na
var float restCSD    = na
var bool  restLong   = false

blocked = onePerDay and (tookLong or tookShort)

longSignal = (canTrade and sweptLow and not blocked and not na(refHigh) and
     close > refHigh)
shortSignal = (canTrade and sweptHigh and not blocked and not na(refLow) and
     close < refLow)

// ==========================================
// ==== Trade drawings ======================
// ==========================================
// Declared up here because Pine requires `var` at global scope, but they are
// populated inside the signal branches below.

var box   tpBox   = na
var box   slBox   = na
var line  entryLn = na
var line  csdLn   = na
var label tpLbl   = na
var label slLbl   = na
var label csdLbl  = na
var float restRR  = na

// NOTE: the drawing below is written inline rather than wrapped in a helper
// function, and it has to stay that way. Pine functions cannot assign to
// global variables, so a drawTrade() helper that sets tpBox/slBox/... simply
// will not compile. Do not "tidy" this into a function.

newTrade = false

if longSignal
    st = nz(sweepLowPx, low) - stopBufferATR * atrVal
    risk = close - st
    reward = asiaHigh - close
    if risk > 0 and reward > 0 and (minRR <= 0 or reward / risk >= minRR)
        restStop   := st
        restTarget := asiaHigh
        restEntry  := close
        restCSD    := refHigh
        restRR     := reward / risk
        restLong   := true
        tookLong   := true
        newTrade   := true
        strategy.entry("Asia Long", strategy.long)
        strategy.exit("Asia Long X", from_entry="Asia Long", stop=st, limit=asiaHigh)
else if shortSignal
    st = nz(sweepHighPx, high) + stopBufferATR * atrVal
    risk = st - close
    reward = close - asiaLow
    if risk > 0 and reward > 0 and (minRR <= 0 or reward / risk >= minRR)
        restStop   := st
        restTarget := asiaLow
        restEntry  := close
        restCSD    := refLow
        restRR     := reward / risk
        restLong   := false
        tookShort  := true
        newTrade   := true
        strategy.entry("Asia Short", strategy.short)
        strategy.exit("Asia Short X", from_entry="Asia Short", stop=st, limit=asiaLow)

// The full trade picture, drawn the way TradingView's own Long/Short Position
// tool looks: a green box from entry up to target, a red box from entry down
// to stop, the entry itself as a solid line, and the CSD level it triggered
// off. Every historical trade keeps its own set.
if newTrade and showBracket
    tpBox := box.new(bar_index, restTarget, bar_index + 1, restEntry,
         bgcolor=color.new(tpColor, boxTransp), border_color=color.new(tpColor, 45),
         border_width=1)
    slBox := box.new(bar_index, restEntry, bar_index + 1, restStop,
         bgcolor=color.new(slColor, boxTransp), border_color=color.new(slColor, 45),
         border_width=1)
    entryLn := line.new(bar_index, restEntry, bar_index + 1, restEntry,
         color=color.new(color.white, 20), width=2)
    tpLbl := label.new(bar_index + 1, restTarget,
         "TP " + str.tostring(restTarget, format.mintick) + "   " +
         str.tostring(restRR, "#.##") + "R",
         style=label.style_label_left, textcolor=tpColor,
         color=color.rgb(0, 0, 0, 100), size=size.small)
    slLbl := label.new(bar_index + 1, restStop,
         "SL " + str.tostring(restStop, format.mintick),
         style=label.style_label_left, textcolor=slColor,
         color=color.rgb(0, 0, 0, 100), size=size.small)

if newTrade and showCSD and not na(restCSD)
    csdLn := line.new(bar_index - csdExtendBack, restCSD, bar_index + 1, restCSD,
         color=csdColor, width=2)
    csdLbl := label.new(bar_index, restCSD, "CSD",
         style=restLong ? label.style_label_down : label.style_label_up,
         textcolor=csdColor, color=color.rgb(0, 0, 0, 100), size=size.tiny)

// Stretch the trade drawings rightward while the position is live, then stop.
// A box that keeps growing after the trade closed misrepresents how long the
// position was actually held.
inTrade2 = strategy.position_size != 0
if inTrade2 and not na(tpBox)
    box.set_right(tpBox, bar_index + 1)
    box.set_right(slBox, bar_index + 1)
    line.set_x2(entryLn, bar_index + 1)
    label.set_x(tpLbl, bar_index + 1)
    label.set_x(slLbl, bar_index + 1)
    if not na(csdLn)
        line.set_x2(csdLn, bar_index + 1)

// ==========================================
// ==== Asia session box (Leviathan style) ==
// ==========================================
// Same construction the Market Sessions indicator uses: open a box when the
// session starts, then push its top/bottom/right out on every bar inside it.

var box   asiaBox  = na
var line  asiaHiLn = na
var line  asiaLoLn = na
var label asiaLbl  = na

if asiaStarted and showRange
    asiaBox := box.new(bar_index, high, bar_index + 1, low,
         bgcolor=color.new(asiaColor, 92), border_color=color.new(asiaColor, 40),
         border_width=1, border_style=line.style_dashed)
    asiaLbl := label.new(bar_index, high, "ASIA", style=label.style_label_down,
         textcolor=color.new(asiaColor, 25), color=color.rgb(0, 0, 0, 100),
         size=size.tiny)

if inAsia and showRange and not na(asiaBox)
    box.set_top(asiaBox, liveHigh)
    box.set_bottom(asiaBox, liveLow)
    box.set_right(asiaBox, bar_index + 1)
    label.set_y(asiaLbl, liveHigh)

// Once Asia closes, run its high and low forward as dashed rails. These are
// the levels the strategy is actually trading against -- one is the liquidity
// that gets swept, the other is the target -- so they need to stay visible.
if not inAsia and inAsia[1] and showRange
    asiaHiLn := line.new(bar_index, asiaHigh, bar_index + 1, asiaHigh,
         color=color.new(bullColor, 25), width=1, style=line.style_dashed)
    asiaLoLn := line.new(bar_index, asiaLow, bar_index + 1, asiaLow,
         color=color.new(bearColor, 25), width=1, style=line.style_dashed)

if not inAsia and showRange and not na(asiaHiLn)
    line.set_x2(asiaHiLn, bar_index + 1)
    line.set_x2(asiaLoLn, bar_index + 1)

plotshape(longSignal, title="CSD long", style=shape.triangleup,
          location=location.belowbar, color=bullColor, size=size.tiny)
plotshape(shortSignal, title="CSD short", style=shape.triangledown,
          location=location.abovebar, color=bearColor, size=size.tiny)

// ==================
// ==== Alerts ======
// ==================
// alert(), not alertcondition() -- the latter is silently inert inside a
// strategy(). Create these with the "Any alert() function call" condition.

if longSignal
    alert("Asia Sweep: long CSD on " + syminfo.ticker + " " + timeframe.period,
          alert.freq_once_per_bar_close)
if shortSignal
    alert("Asia Sweep: short CSD on " + syminfo.ticker + " " + timeframe.period,
          alert.freq_once_per_bar_close)

// ==========================================
// ==== Tracker update -- MUST BE LAST ======
// ==========================================
// Updated after the bar has been judged, so the CSD reference is always the
// PREVIOUS down/up-close bar rather than this one. Moving this higher would
// let a single bar be both the reference and the trigger.

if close < open
    lastDownHigh := high
else if close > open
    lastUpLow := low
